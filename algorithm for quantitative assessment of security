# ### 4.1 Вспомогательные функции

def get_prop_value(individual, prop_name):
    """Получение значения свойства данных"""
    for prop in individual.get_properties():
        if prop_name in str(prop):
            if individual[prop]:
                return float(individual[prop][0])
    raise ValueError(f"Свойство {prop_name} не найдено у {individual}")

def get_relations(individual, onto, is_incoming=False):
    """Получение связей"""
    relations = {}
    for prop in onto.object_properties():
        prop_str = str(prop)
        if 'sendsDataTo' in prop_str or 'controls' in prop_str or 'connectsTo' in prop_str:
            rel_type = prop_str.split('#')[-1]
            weight = WEIGHT_RELATIONS.get(rel_type, 0.5)
            if is_incoming:
                for source in onto.individuals():
                    if individual in source[prop]:
                        relations[str(source)] = weight
            else:
                for target in individual[prop]:
                    relations[str(target)] = weight
    return relations

def get_related(individual, relation_name):
    """Получение связанных индивидов"""
    results = []
    for prop in individual.get_properties():
        if relation_name in str(prop):
            for target in individual[prop]:
                results.append(str(target))
    return results

# ### 4.2 Извлечение СФХ

# Поиск класса SFX
sfx_class = None
for cls in onto.classes():
    if 'SFX' in str(cls):
        sfx_class = cls
        break

sfx_data = {}
for ind in sfx_class.instances():
    sfx_id = str(ind)
    sfx_name = sfx_id.split('#')[-1] if '#' in sfx_id else sfx_id
    
    # Извлечение свойств из онтологии
    involvement = get_prop_value(ind, 'hasInvolvement')
    fault_tolerance = get_prop_value(ind, 'hasFaultTolerance')
    
    # Связи
    incoming_rels = get_relations(ind, onto, is_incoming=True)
    outgoing_rels = get_relations(ind, onto, is_incoming=False)
    
    # Цели
    goals = get_related(ind, 'hasGoal')
    
    # Связанные СФХ
    related_sfx = []
    for prop in onto.object_properties():
        if 'connectsTo' in str(prop) or 'sendsDataTo' in str(prop):
            for target in ind[prop]:
                related_sfx.append(str(target))
    
    sfx_data[sfx_id] = {
        'id': sfx_id,
        'name': sfx_name,
        'involvement': involvement,
        'fault_tolerance': fault_tolerance,
        'goals': goals,
        'related_sfx': related_sfx,
        'incoming_relations': incoming_rels,
        'outgoing_relations': outgoing_rels,
        # Рассчитываемые показатели
        'S_SFC': 0.0,
        'I_sfc': 0.0
    }

print(f"Извлечено СФХ: {len(sfx_data)}")
for sfx_id, data in sfx_data.items():
    print(f"  - {data['name']}: involvement={data['involvement']}, FT={data['fault_tolerance']}")

# ### 4.3 Извлечение уязвимостей

vuln_class = None
for cls in onto.classes():
    if 'Vulnerability' in str(cls):
