# ## 2. Константы

# Диапазон нормализации
MIN_SCORE = 0.2
MAX_SCORE = 1.0

# Веса для формулы (2.19)
ALPHA_W = 0.75
BETA_W = 0.25

# Коэффициент усиления входящих дуг (формулы 2.5, 2.7)
ALPHA_IN = 1.2

# Веса типов связей (формулы 2.4-2.7)
WEIGHT_RELATIONS = {
    'connectsTo': 0.8,
    'sendsDataTo': 1.0,
    'controls': 1.2,
    'uses_protocol': 0.6
}

WEIGHT_MESSAGES = {
    'measurement': 0.5,
    'info': 0.7,
    'command': 1.2,
    'alert': 0.9
}

# Границы категорий (после нормализации)
CATEGORY_BOUNDARIES = {
    'Низкий': (0.2, 0.38),
    'Средний': (0.38, 0.58),
    'Высокий': (0.58, 0.82),
    'Критичный': (0.82, 1.0)
}

# ## 3. Функции нормализации

def normalize_score(value, min_val=0.0, max_val=1.0):
    """
    Минимаксная нормализация (формула 2.1)
    """
    if max_val == min_val:
        return MIN_SCORE
    normalized = MIN_SCORE + (value - min_val) / (max_val - min_val) * (MAX_SCORE - MIN_SCORE)
    return max(MIN_SCORE, min(MAX_SCORE, normalized))

def get_category(value):
    """Определение категории по значению"""
    for level, (low, high) in CATEGORY_BOUNDARIES.items():
        if low <= value <= high:
            return level
    return "Не определено"

# ## 4. Загрузка и извлечение данных из онтологии

# Путь к размеченному OWL-файлу (после работы резонера в Protege)
