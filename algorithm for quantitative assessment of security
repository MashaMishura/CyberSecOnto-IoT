        'name': get_prop_value(ind, 'hasName'),
        'danger_score': get_prop_value(ind, 'hasDangerScore'),
        'cve': get_prop_value(ind, 'hasCVE') if hasattr(ind, 'hasCVE') else '',
        'cwe': get_prop_value(ind, 'hasCWE') if hasattr(ind, 'hasCWE') else '',
        'affected_sfx': get_related(ind, 'affects_sfx')
    }

print(f"Извлечено уязвимостей: {len(vuln_data)}")

# %% [markdown]
# ### 4.4 Извлечение атак

attack_class = None
for cls in onto.classes():
    if 'AttackPattern' in str(cls):
        attack_class = cls
        break

attack_data = {}
for ind in attack_class.instances():
    attack_id = str(ind)
    attack_data[attack_id] = {
        'id': attack_id,
        'name': get_prop_value(ind, 'hasName'),
        'likelihood': get_prop_value(ind, 'hasLikelihood'),
        'severity': get_prop_value(ind, 'hasSeverity'),
        'similarity': get_prop_value(ind, 'hasSimilarity') if hasattr(ind, 'hasSimilarity') else 0.0,
