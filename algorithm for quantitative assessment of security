        'S_Attack': 0.0  # будет рассчитано
    }

print(f"Извлечено атак: {len(attack_data)}")

# ### 4.5 Извлечение угроз

threat_class = None
for cls in onto.classes():
    if 'Threat' in str(cls):
        threat_class = cls
        break

threat_data = {}
for ind in threat_class.instances():
    threat_id = str(ind)
    threat_data[threat_id] = {
        'id': threat_id,
        'name': get_prop_value(ind, 'hasName'),
        'description': get_prop_value(ind, 'hasDescription') if hasattr(ind, 'hasDescription') else '',
        'target_sfx': get_related(ind, 'targets_sfx'),
        'conf_impact': int(get_prop_value(ind, 'hasConfImpact')) if hasattr(ind, 'hasConfImpact') else 0,
        'int_impact': int(get_prop_value(ind, 'hasIntImpact')) if hasattr(ind, 'hasIntImpact') else 0,
        'avail_impact': int(get_prop_value(ind, 'hasAvailImpact')) if hasattr(ind, 'hasAvailImpact') else 0,
        'S_T': 0.0  # будет рассчитано
    }

print(f"Извлечено угроз: {len(threat_data)}")

# ### 4.6 Извлечение контекстных параметров

domain_criticality = 0.5
for cls in onto.classes():
    if 'Domain' in str(cls):
        for ind in cls.instances():
            domain_criticality = get_prop_value(ind, 'hasCriticalityScore')
        break

goal_criticality = 0.5
for cls in onto.classes():
    if 'Goal' in str(cls):
        for ind in cls.instances():
            goal_criticality = get_prop_value(ind, 'hasCriticalityScore')
        break

print(f"Критичность домена (S_D): {domain_criticality}")
print(f"Критичность цели (S_G): {goal_criticality}")

# ## 5. Расчет показателей

print("\n" + "="*60)
print("ШАГ 1: Базовая оценка объекта (формулы 2.3-2.9)")
print("="*60)

# --- 5.1 Расчет задействованности СФХ (формулы 2.4-2.8) ---
for sfx_id, sfx in sfx_data.items():
    # Исходящие прямые связи (2.4)
    Out_R = sum(sfx['outgoing_relations'].values())
    
    # Входящие прямые связи (2.5)
    In_R = ALPHA_IN * sum(sfx['incoming_relations'].values())
    
    # Исходящие сообщения (2.6)
    Out_M = 0  # Если есть сообщения в онтологии
    In_M = 0   # Если есть сообщения в онтологии
    
    # Полный показатель задействованности (2.8)
    I_sfc = Out_R + In_R + Out_M + In_M
    sfx['I_sfc'] = normalize_score(I_sfc / 10.0)
    
    # Опасность СФХ (2.3)
    S_SFC = sfx['I_sfc'] * (1 - sfx['fault_tolerance'])
    sfx['S_SFC'] = S_SFC
    
    print(f"{sfx['name']}: I={sfx['I_sfc']:.3f}, S_SFC={S_SFC:.3f}")

# --- 5.2 Максимальная опасность СФХ ---
S_SFC_max = max(sfx['S_SFC'] for sfx in sfx_data.values())
print(f"\nМаксимальная опасность СФХ (S_SFC_max): {S_SFC_max:.3f}")

# --- 5.3 Уровень критичности объекта (2.9) ---
S_Object = 0.2 + ((domain_criticality + goal_criticality) / 1.6) * S_SFC_max
S_Object = normalize_score(S_Object)
print(f"Уровень критичности объекта (S_Object): {S_Object:.3f}")

# ## 6. Оценка уязвимостей (формула 2.10)

print("\n" + "="*60)
print("ШАГ 2: Оценка уязвимостей (формула 2.10)")
print("="*60)

for vuln_id, vuln in vuln_data.items():
    # Нормализация внешней оценки в диапазон [0.2, 1.0]
    vuln['danger_score'] = normalize_score(vuln['danger_score'] / 10.0)
    print(f"{vuln['name']}: S_Vulnerability={vuln['danger_score']:.3f}")

# ## 7. Оценка атак (формулы 2.11-2.14)

print("\n" + "="*60)
print("ШАГ 3: Оценка атак (формулы 2.11-2.14)")
print("="*60)

# --- 7.1 Критичность атак (2.11) ---
for attack_id, attack in attack_data.items():
    S_Attack = attack['likelihood'] * attack['severity']
    
    # Интерпретация для высоковлияющих атак
    if attack['severity'] >= 0.82:
        S_Attack = attack['severity']
    
    attack['S_Attack'] = normalize_score(S_Attack)
    print(f"{attack['name']}: S_Attack={attack['S_Attack']:.3f}")

# --- 7.2 Расчет распространения атак (2.12-2.14) ---
print("\nРаспространение атак между компонентами:")

# Построение взвешенного графа
max_weight = 0.0
edge_weights = {}

for sfx_id, sfx in sfx_data.items():
    for target_id in sfx['related_sfx']:
        weight = sfx['outgoing_relations'].get(target_id, 0)
        edge_weights[(sfx_id, target_id)] = weight
        if weight > max_weight:
            max_weight = weight

# Вероятности перехода (2.12)
prop_attacks = {}
for (src, dst), weight in edge_weights.items():
    if max_weight > 0:
        p_prop = weight / max_weight
        prop_attacks[(src, dst)] = p_prop
        print(f"  {src} -> {dst}: p_prop={p_prop:.3f}")

# ## 8. Оценка угроз (формулы 2.15-2.17)

print("\n" + "="*60)
print("ШАГ 4: Оценка угроз (формулы 2.15-2.17)")
print("="*60)

for threat_id, threat in threat_data.items():
    S_T_values = []
    
    for sfx_id in threat['target_sfx']:
        if sfx_id not in sfx_data:
            continue
        
        sfx = sfx_data[sfx_id]
        S_G = goal_criticality
        S_SFC = sfx['S_SFC']
        
        # Находим уязвимости для этой СФХ
        vulns_for_sfx = [v for v in vuln_data.values() if sfx_id in v['affected_sfx']]
        
        if not vulns_for_sfx:
            continue
        
        for vuln in vulns_for_sfx:
            S_Vuln = vuln['danger_score']
            
            # Находим атаки, связанные с этой уязвимостью
            attacks_for_vuln = [a for a in attack_data.values() 
                               if any(w in a['related_weaknesses'] for w in [vuln['cwe']])]
            
            # Вероятностная составляющая
            if attacks_for_vuln:
                prob = 1 - np.prod([1 - a['S_Attack'] for a in attacks_for_vuln])
            else:
                prob = 0
            
            # Уровень опасности угрозы (2.15)
            S_T = S_G * S_SFC * S_Vuln * prob
            S_T_values.append(S_T)
    
    # Агрегация угроз для СФХ (2.16) - используется max
    threat['S_T'] = max(S_T_values) if S_T_values else 0
    threat['S_T'] = normalize_score(threat['S_T'])
    
    print(f"{threat['name']}: S_T={threat['S_T']:.3f}")

# Интегральный уровень опасности угроз (2.17)
S_Threat = max(threat['S_T'] for threat in threat_data.values()) if threat_data else 0
print(f"\nИнтегральный уровень опасности угроз (S_Threat): {S_Threat:.3f}")

# ## 9. Оценка рисков (формула 2.18)

print("\n" + "="*60)
print("ШАГ 5: Оценка рисков (формула 2.18)")
print("="*60)

for threat_id, threat in threat_data.items():
    S_Risk = threat['S_T'] * domain_criticality
    threat['S_Risk'] = normalize_score(S_Risk)
    print(f"{threat['name']}: S_Risk={threat['S_Risk']:.3f}")

# ## 10. Итоговая оценка защищённости (формула 2.19)

print("\n" + "="*60)
print("ШАГ 6: Итоговая оценка защищённости (формула 2.19)")
print("="*60)

# --- 10.1 Вероятность компрометации ---
all_attacks = list(attack_data.values())
if all_attacks:
    prob_compromise = 1 - np.prod([1 - a['S_Attack'] for a in all_attacks])
else:
    prob_compromise = 0

print(f"Вероятность компрометации: {prob_compromise:.3f}")

# --- 10.2 Потенциал негативного воздействия ---
avg_vuln_score = np.mean([v['danger_score'] for v in vuln_data.values()]) if vuln_data else 0.5
negative_potential = ALPHA_W * domain_criticality + BETA_W * S_SFC_max * avg_vuln_score
print(f"Потенциал негативного воздействия: {negative_potential:.3f}")

# --- 10.3 Итоговая оценка (2.19) ---
Security_Score = (1 / S_Object) * prob_compromise * negative_potential
Security_Score = normalize_score(Security_Score)

print(f"\n{'='*60}")
print(f"ИТОГОВАЯ ОЦЕНКА ЗАЩИЩЕННОСТИ")
print(f"{'='*60}")
print(f"Security_Score: {Security_Score:.3f}")
print(f"Уровень защищённости: {get_category(Security_Score)}")

